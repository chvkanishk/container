# Copy to .env on each laptop and fill in. NEVER commit .env

# Supabase: Project Settings > Database > Session pooler (IPv4)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# 'A' on laptop A, 'B' on laptop B. This is the only line that differs.
NODE_NAME=A

# Minutes between handoffs. 5 for testing, 15 for normal running.
CYCLE_MINUTES=15

# Ignore postings older than this many minutes. Keep it well above
# 4 x CYCLE_MINUTES so nothing slips through if one laptop is off.
MAX_AGE_MINUTES=120
